# SkillX Frontend Environment Variables (Only needed for Option 2 Split Deployment)
# If using Option 1 (Single Fullstack Web Service), leave these empty or unset.

# URL of your Render Backend Web Service (without trailing slash)
VITE_API_URL=https://skillx-backend.onrender.com

# Optional WebSocket URL (defaults to VITE_API_URL if omitted)
VITE_SOCKET_URL=https://skillx-backend.onrender.com
