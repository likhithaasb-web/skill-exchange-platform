# SkillX Backend Environment Variables (Production & Development)
PORT=5000
NODE_ENV=production

# MongoDB Connection String (e.g. MongoDB Atlas M0 cluster)
# Format: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/skillx_db?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://username:password@cluster0.mongodb.net/skillx_db?retryWrites=true&w=majority

# JWT Secret for authenticating sessions (Generate a random 32+ character string)
JWT_SECRET=super_secret_skillx_jwt_key_change_in_production_994827

# Frontend Client URL(s) for CORS (Comma-separated if multiple, e.g. for split deploy)
# If using Option 1 (Single Fullstack Web Service), this is optional as frontend is served on the same domain.
CLIENT_URL=https://skillx-frontend.onrender.com,http://localhost:5173
